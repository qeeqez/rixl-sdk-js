#!/usr/bin/env sh
# Pre-push guardrail: regenerate the SDK from the upstream OpenAPI spec, build,
# format, lint/type-check, and test the full project before allowing a push.
# Anything caught here would otherwise fail CI on `.github/workflows/release.yml`.
set -e

RIXL_GENERATE=true vp pack
git add -A src/generated
vp fmt --write
vp check
vp test --run
